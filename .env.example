# Copy this file to `.env` and adjust values. The real `.env` is gitignored —
# never commit secrets. Docker Compose reads `.env` automatically.

# --- PostgreSQL ---
POSTGRES_USER=portal
POSTGRES_PASSWORD=portal-dev-password
POSTGRES_DB=portal

# --- Backend ---
# Must match the Postgres values above. Host "db" is the Compose service name.
DATABASE_URL=postgresql+psycopg://portal:portal-dev-password@db:5432/portal
ENVIRONMENT=development

# --- Attachment storage ---
# local = files on a Docker volume (default). s3 = S3-compatible server (MinIO)
# using the values below; requires the minio service / an external endpoint.
STORAGE_BACKEND=local

# --- MinIO (only used when STORAGE_BACKEND=s3) ---
MINIO_ROOT_USER=portal
MINIO_ROOT_PASSWORD=portal-dev-secret
MINIO_BUCKET=attachments

# --- Dispatch (email) ---
# stub = only log (default). smtp = send real email with the settings below.
DISPATCH_TRANSPORT=stub
# Comma-separated recipients of every dispatch package (the blue team mailbox).
DISPATCH_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# 587 + STARTTLS (default) or 465 + SMTP_SSL=true
SMTP_STARTTLS=true
SMTP_SSL=false
