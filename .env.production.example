# Production settings. Copy to .env.production on the server and fill in REAL values.
# This file is read by docker-compose.prod.yml. NEVER commit .env.production.

ENVIRONMENT=production

# --- Public address (see docs/DEPLOYMENT.md §3) ---
PORTAL_SERVER_NAME=portal.redteam.my-organization.com
# Folder with fullchain.pem (server cert + intermediates) and privkey.pem
PORTAL_CERT_DIR=./certs

# --- Database ---
POSTGRES_USER=portal
POSTGRES_PASSWORD=CHANGE-ME-long-random
POSTGRES_DB=portal
DATABASE_URL=postgresql+psycopg://portal:CHANGE-ME-long-random@db:5432/portal

# --- Auth ---
# REQUIRED: the API refuses to start in production with the dev secret or a short one.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Optional: choose the first admin's password; otherwise a random one is printed once
# in `docker compose logs api`. Either way it must be changed at first login.
FIRST_ADMIN_PASSWORD=

# --- Attachment storage ---
STORAGE_BACKEND=local

# --- Dispatch (email) ---
DISPATCH_TRANSPORT=smtp
DISPATCH_TO=blue-team@my-organization.com
SMTP_HOST=smtp.my-organization.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=portal@my-organization.com
SMTP_STARTTLS=true
SMTP_SSL=false
