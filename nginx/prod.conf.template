# Production reverse proxy (SPEC / docs/DEPLOYMENT.md §1, §3, §4).
#
# The official nginx image renders this file with envsubst at start-up (only the
# PORTAL_* variables are substituted) into /etc/nginx/conf.d/default.conf.
# TLS terminates here; api and web speak plain HTTP on the private Docker network.

# Plain HTTP only redirects to HTTPS.
server {
    listen 80;
    server_name ${PORTAL_SERVER_NAME};
    server_tokens off;
    return 301 https://$host${PORTAL_PORT_SUFFIX}$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${PORTAL_SERVER_NAME};
    server_tokens off;

    # Server certificate + intermediate chain concatenated, and its private key.
    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # Attachments and evidence go up to 50 MB per file; 100 MB leaves headroom.
    # (nginx defaults to 1 MB, which would reject uploads with a confusing 413.)
    client_max_body_size 100m;

    # Docker's internal DNS.
    resolver 127.0.0.11 valid=30s;

    # --- Security headers (defined only at server level, so nothing is lost to
    # add_header's per-location inheritance rules) ---
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
    # The app loads nothing from other origins. 'unsafe-inline' for styles only:
    # Vue sets some inline style attributes at runtime. Scripts are same-origin only.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;

    # --- API: /api/* -> backend root (the backend owns no /api prefix) ---
    location /api/ {
        proxy_pass http://api:8000/;

        # The audit log records client IPs (SPEC D8). The headers are OVERWRITTEN,
        # not appended to: a client must not be able to choose the address that
        # ends up in the audit log by sending its own X-Forwarded-For.
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Exports and dispatch (PDF rendering, SMTP delivery) can take a while.
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # --- Everything else: the built frontend ---
    location / {
        proxy_pass http://web:80;
        proxy_set_header Host $host;
    }
}
